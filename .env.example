# Banco (PostgreSQL — Railway)
DATABASE_URL=postgresql://user:pass@localhost:5432/tino

# Arquivos e PDFs
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mail
RESEND_API_KEY=

# WhatsApp Cloud API (Meta)
# Credencial NUNCA vai para o banco: é a correção do problema 3 da v1,
# em que access token e verify token viviam em texto plano numa tabela.
# A aba WhatsApp do admin mostra se cada uma chegou, jamais o valor.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Opcionais: WABA aparece na tela para conferência; o template é o aviso
# de handoff aprovado na Meta (sem ele o aviso tenta ir como texto, o que
# só funciona dentro da janela de 24h).
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_HANDOFF=

# Agente de WhatsApp (IA)
# Gemini 2.5 Flash falado direto com o Google, em API compatível com a da
# OpenAI. Até 24/08 isto passava pelo gateway do Forge (Manus), que saiu do
# ar; os nomes agora são genéricos justamente para que a próxima troca de
# provedor não precise renomear nada. Só o `agente.ts` fala com o modelo.
#
# A chave sai do Google AI Studio (aistudio.google.com/apikey) e vale para
# a conta Google que a criou. Não reaproveite a antiga FORGE_API_KEY: era
# do Manus e não autentica no Google — apague-a do ambiente.
LLM_API_KEY=
# Opcionais, com padrão embutido. LLM_API_URL é tudo que vem antes de
# `/chat/completions` — no Google o trecho é /v1beta/openai, não /v1.
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODELO=gemini-3.6-flash

# Base pública — entra nos links de portal que a IA manda ao cliente
NEXT_PUBLIC_SITE_URL=https://tinoestudio.com.br
