# Banco (PostgreSQL — Railway)
DATABASE_URL=postgresql://user:pass@localhost:5432/tino

# Arquivos e PDFs
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mail
RESEND_API_KEY=

# WhatsApp Cloud API (Meta)
# Credencial NUNCA vai para o banco: é a correção do problema 3 da v1,
# em que access token e verify token viviam em texto plano numa tabela.
# A aba WhatsApp do admin mostra se cada uma chegou, jamais o valor.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Opcionais: WABA aparece na tela para conferência; o template é o aviso
# de handoff aprovado na Meta (sem ele o aviso tenta ir como texto, o que
# só funciona dentro da janela de 24h).
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_HANDOFF=

# Agente de WhatsApp (IA)
# Mesmo modelo e mesmo gateway da v1: Gemini 2.5 Flash pelo Forge (Manus),
# em API compatível com a da OpenAI. A v1 guardava esta chave em
# OPENAI_API_KEY mesmo apontando para o Forge — as duas são aceitas.
# Atenção: a chave é da plataforma que a v2 está deixando. Se a assinatura
# do Manus cair, o atendimento para — e a troca é só destas variáveis,
# porque só o `agente.ts` fala com o modelo.
FORGE_API_KEY=
# Opcionais, com padrão embutido:
# FORGE_API_URL=https://forge.manus.im
# FORGE_MODELO=gemini-2.5-flash

# Base pública — entra nos links de portal que a IA manda ao cliente
NEXT_PUBLIC_SITE_URL=https://tinoestudio.com.br
